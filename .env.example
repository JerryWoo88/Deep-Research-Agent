# DeepSeek (or any OpenAI-compatible provider): key + endpoint
OPENAI_API_KEY=your-deepseek-api-key-here
API_BASE_URL=https://api.deepseek.com/v1

# SEC EDGAR identity, sent as User-Agent to sec.gov (required by SEC)
SEC_USER_AGENT=YourName your_email@example.com

# Optional: only if you switch tiers back to Gemini (direct) or Claude
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
